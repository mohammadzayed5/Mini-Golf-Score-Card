    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <!-- Status bar handling via app (common for Capacitor) -->
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>

  <!-- Google AdMob App ID -->
  <key>GADApplicationIdentifier</key>
  <string>ca-app-pub-5108646735858325~1799492394</string>

  <!--
    Required before calling ATTrackingManager.requestTrackingAuthorization.
    AdMobContext.jsx requests tracking authorization; without this key iOS
    raises NSInternalInconsistencyException at the moment it tries to present
    the prompt, and that is a native abort a JS try/catch cannot intercept.

    Keep the wording aligned with the App Tracking Transparency section of
    the privacy policy at minigolfscoretracker.com/privacy.
  -->
  <key>NSUserTrackingUsageDescription</key>
  <string>Allow tracking so the ads in Mini Golf Score Tracker are more relevant to you. Your scores and player names are never shared.</string>

